# Normalise line endings in the repository so a checkout on any OS produces
# identical bytes. Text files are stored with LF; binaries are left untouched.

* text=auto eol=lf

# Explicit text types
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf

# Binary assets — never diff or convert these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.zip   binary

# Keep generated output out of language stats on GitHub
dist/** linguist-generated=true
