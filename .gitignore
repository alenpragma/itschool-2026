# --- Dependencies -----------------------------------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.js

# --- Build output -----------------------------------------------------------
# `npm run build` assembles the whole publishable site into dist/.
# dist/ is a BUILD ARTIFACT: it is regenerated from src/ + public/ on every
# build and must never be committed or hand-edited.
dist/

# --- Local checks / QA scratch output ---------------------------------------
# Local screenshot dumps, verification runs and scratch tooling.
*check/
qc/
qa_v*/
shots/
_shots/
*.local.html

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment / secrets --------------------------------------------------
.env
.env.local
.env.*.local

